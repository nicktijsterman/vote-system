<?xml version="1.0"?>
<psalm
    errorLevel="6"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="app"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin"/>
    </plugins>
    <issueHandlers>
        <MoreSpecificReturnType errorLevel="suppress"/>
        <LessSpecificReturnStatement errorLevel="suppress"/>
        <MoreSpecificImplementedParamType errorLevel="suppress" />
        <ImplementedReturnTypeMismatch errorLevel="suppress" />
        <!-- Both of these have a high false-positive rate in a Laravel app: Psalm can't see
             methods called from .blade.php templates (never parsed) or constructors resolved
             implicitly by the service container, and flags them as unused. -->
        <PossiblyUnusedMethod errorLevel="suppress" />
        <PossiblyUnusedReturnValue errorLevel="suppress" />
        <!-- VoterVoted::$results is a promoted constructor property; Psalm doesn't honor an
             inline @psalm-suppress comment on the parameter itself, so it's suppressed here
             instead. It's genuinely used - serialized into the broadcast payload and read by
             LiveApplicationControls.vue - Psalm just can't see either consumer. -->
        <PossiblyUnusedProperty errorLevel="suppress">
            <errorLevel type="suppress">
                <file name="app/Events/VoterVoted.php"/>
            </errorLevel>
        </PossiblyUnusedProperty>
    </issueHandlers>
</psalm>
